# ---------------------------------------------------------------------------
# Haunted Honeypot — environment variable reference
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Trap configuration
# ---------------------------------------------------------------------------

# Port the fake SSH server listens on inside the container.
# The host firewall should forward port 22 → TRAP_PORT on the host.
TRAP_PORT=2222

# Path inside the container where the Ed25519 host key is stored/loaded.
# Must be on a named Docker volume so it survives container restarts.
TRAP_HOST_KEY_PATH=/data/keys/host_ed25519

# Path to the credential list file (one username:password per line).
TRAP_CREDENTIAL_FILE=/app/trap/credentials_default.txt

# Directory where per-session JSON Lines log files are written.
TRAP_LOG_DIR=/data/logs

# Idle timeout: close a session after this many seconds with no input.
TRAP_IDLE_TIMEOUT_SECONDS=300

# Maximum session duration in seconds regardless of activity.
TRAP_MAX_SESSION_SECONDS=1800

# (Optional) Accept any password after this many attempts from the same IP
# within a rolling one-hour window. Leave unset to disable.
# TRAP_ACCEPT_AFTER_ATTEMPTS=5

# ---------------------------------------------------------------------------
# LLM backend (Phase 2 — leave as "scripted" for the initial deployment)
# ---------------------------------------------------------------------------
TRAP_LLM_BACKEND=scripted

# Required only when TRAP_LLM_BACKEND != "scripted":
# TRAP_LLM_API_URL=https://api.openai.com/v1
# TRAP_LLM_API_KEY=sk-...
