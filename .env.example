# ---------------------------------------------------------------------------
# Haunted Honeypot — environment variable reference
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Trap configuration
# ---------------------------------------------------------------------------

# Port the fake SSH server listens on inside the container.
# The host firewall should forward port 22 → TRAP_PORT on the host.
TRAP_PORT=2222

# Path inside the container where the Ed25519 host key is stored/loaded.
# Must be on a named Docker volume so it survives container restarts.
TRAP_HOST_KEY_PATH=/data/keys/host_ed25519

# Path to the credential list file (one username:password per line).
TRAP_CREDENTIAL_FILE=/app/trap/credentials_default.txt

# Directory where per-session JSON Lines log files are written.
TRAP_LOG_DIR=/data/logs

# Idle timeout: close a session after this many seconds with no input.
TRAP_IDLE_TIMEOUT_SECONDS=300

# Maximum session duration in seconds regardless of activity.
TRAP_MAX_SESSION_SECONDS=1800

# (Optional) Accept any password after this many attempts from the same IP
# within a rolling one-hour window. Leave unset to disable.
# TRAP_ACCEPT_AFTER_ATTEMPTS=5

# ---------------------------------------------------------------------------
# LLM backend
# ---------------------------------------------------------------------------
# "scripted" (default) or "gemini".
TRAP_LLM_BACKEND=scripted

# Required only when TRAP_LLM_BACKEND=gemini. Never commit a real key.
# TRAP_LLM_API_KEY=your-gemini-api-key-here
# TRAP_LLM_MODEL=your-gemini-model-name

# Maximum LLM calls per UTC day across all sessions (positive integer).
TRAP_LLM_DAILY_LIMIT=500

# ---------------------------------------------------------------------------
# Brain configuration
# ---------------------------------------------------------------------------

# REQUIRED. Directory containing the trap's per-session *.jsonl logs
# (mount the trap's TRAP_LOG_DIR volume read-only here).
BRAIN_LOG_DIR=/data/logs

# REQUIRED. Bearer token the dashboard must send to the Brain API.
# Use a long random value. Never commit a real token.
BRAIN_API_TOKEN=change-me

# Path of the SQLite database file (default: brain.db).
BRAIN_DATABASE_PATH=/data/brain.db

# (Optional) LLM API key for generating Lab Notes. If unset, template notes
# are used. Never commit a real key.
# BRAIN_LLM_API_KEY=your-gemini-api-key-here

# LLM model used for Lab Notes (default: gemini-1.5-flash).
BRAIN_LLM_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Dashboard / Caddy
# ---------------------------------------------------------------------------

# Public host name Caddy serves, e.g. lab.example.org. Caddy obtains HTTPS
# certificates automatically for public names (ports 80 and 443 must be
# reachable). Leave empty to serve plain HTTP on port 80 (local testing).
DOMAIN=
